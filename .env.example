# WeChat Mini Program credentials
WX_APPID=your-wechat-appid
WX_SECRET=your-wechat-secret

# Admin console credentials (replace every value before deployment)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
ADMIN_SESSION_HOURS=12
# Set to true when the public admin URL uses HTTPS
ADMIN_COOKIE_SECURE=false

# Container defaults; local development can use sqlite://data/db.sqlite3
DATABASE_URL=sqlite:///app/data/db.sqlite3
TOKEN_EXPIRE_HOURS=2
